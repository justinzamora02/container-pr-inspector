{
  "name": "container-pr-inspector",
  "version": "0.0.1",
  "private": true,
  "description": "Compare Docker images across pull request revisions and enforce regression policy.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justinzamora02/container-pr-inspector.git"
  },
  "packageManager": "pnpm@10.13.1",
  "bin": {
    "container-pr-inspector": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/cli-arguments.js",
    "dist/application.js",
    "dist/core/**/*.js",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./schema/result-v1.json": "./schema/result-v1.schema.json"
  },
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@vercel/ncc",
      "esbuild"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "bundle": "pnpm run build && ncc build src/action.ts -o dist --minify",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --pretty false && tsc -p tsconfig.test.json --pretty false",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run bundle"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.8.0",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@actions/artifact": "^6.2.1",
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@actions/tool-cache": "^4.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@vercel/ncc": "^0.44.1",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^4.1.10"
  }
}
